{
  "expo": {
    "name": "FitTime",
    "slug": "fittime-gym",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "fittime",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-background.png",
        "backgroundColor": "#2563EB"
      },
      "package": "com.constanza.fittime",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "FitTime usa tus fotos para tu imagen de perfil.",
          "cameraPermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#2563EB",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0F1D3A"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b98a7ed5-ecfe-4989-b693-60600abc5361"
      }
    },
    "icon": "./assets/icon.png"
  }
}
