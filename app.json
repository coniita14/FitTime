{
  "expo": {
    "name": "FitTime",
    "slug": "fittime-gym",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "fittime",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0b1120"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b1120"
      },
      "package": "com.constanza.fittime",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-web-browser",
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "FitTime usa tus fotos para tu imagen de perfil.",
          "cameraPermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b98a7ed5-ecfe-4989-b693-60600abc5361"
      }
    }
  }
}
